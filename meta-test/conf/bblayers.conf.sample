# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "6"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  ${TOPDIR}/##ISARROOT_RELATIVE##/meta \
  ${TOPDIR}/##ISARROOT_RELATIVE##/meta-isar \
  ${TOPDIR}/##ISARROOT_RELATIVE##/meta-test \
  "
BBLAYERS_NON_REMOVABLE ?= " \
  ${TOPDIR}/##ISARROOT_RELATIVE##/meta \
  "
